# Marine wind page data written by a local build (marine_wind/pipeline/build.py
# --out marine_wind/page/data); the live data comes from the marine-wind-live
# branch. Kept here, not in marine_wind/page/, because site_publish.yml copies
# that folder into the public repository and a .gitignore there kept data/ from
# ever being committed (the /marine-wind/ "manifest 404").
marine_wind/page/data/

# Verification page data written locally (marine_wind/verify/page_data.py --json
# marine_wind/verification_page/data); the live data comes from the
# verification-data branch.
marine_wind/verification_page/data/
