__pycache__/
*.pyc
*.pyo
*.pyd

# Publish-tool endpoint config (token secret; never commit)
tools/publish.local.json

# Agent worktrees created for isolated subagent runs
.claude/worktrees/

# tools/export_awips.py output
dist/

# Cyclone phase space article, staged into docs/cps/ from
# cyclone_phase_space/article/ by the Pages workflow (.github/workflows/
# pages.yml); never commit the local staging copy.
docs/cps/

# tests/create_xml_windhazards/test_windhazard_xml.py output
tests/create_xml_windhazards/out/

# tests/pressure_gap_fill/ output
tests/pressure_gap_fill/out/
tests/tcwind_jtwc/out/
tests/tc_pressure/out/

# Bookkeeping written by tools/publish.py --deploy ... --flat so a later
# run knows which files it placed. It belongs next to the deployed site on
# the NOAA server, not in the committed flat/ copy (and the flat-sync job
# in .github/workflows/pages.yml skips it by name).
flat/.awips-publish-manifest.json
