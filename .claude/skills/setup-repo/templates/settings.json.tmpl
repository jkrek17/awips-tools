{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash({{TEST_COMMAND}}*)",
      "Bash({{BUILD_COMMAND}}*)",
      "Bash({{LINT_COMMAND}}*)"
    ],
    "deny": [
      "Read({{SECRET_FILE}})",
      "Read(~/{{SECRET_HOME_FILE}})"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-generated.sh"
          }
        ]
      }
    ]
  }
}
