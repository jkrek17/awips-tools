<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  EXPERIMENTAL. Hart CPS combined core index, actual method: same HVTL/
  HVTU and closed-low mask as cps_HCPSclass.xml, squashed into a single
  continuous number from -3 (cold core) to +3 (deep warm core) via
  2*tanh(HVTL/scaleM) + tanh(HVTU/scaleM) - see cps_HartCPS.executeIndexStd
  and D2D/README.md's "Hart CPS family" section.

  Why MSLP for the closed-low mask (cps_HartCPS.closed_low_mask): it is
  one field, the same surface the forecaster already contours, so the
  closed low the mask finds is the closed low drawn on the chart; it is
  defined everywhere, so there is no extrapolation below sea level
  inside a deep low (as there is for 1000 hPa height) and nothing to
  mask below ground; and the ring test reads directly in pressure: the
  annulus 300 to 500 km out must average at least depthHpa (5 hPa)
  above the candidate center, which must itself be within 0.6 hPa of
  the lowest MSLP within 300 km. Pa or hPa are both accepted (the same
  median rule as the surface pressure field).

  Below-ground masking: same as cps_HCPSclass.xml - every one of the six
  height Fields below (the HVTL/HVTU band levels) is blanked (NaN)
  before its own computation wherever it is below ground for its own
  pressure, using the surface pressure field (P, Surface) and capHpa
  below - see cps_HartCPS.mask_below_ground. capHpa (default 900 hPa) is
  a cap, not the literal level pressure: it keeps a deep low's own
  legitimately low surface pressure over open water from being mistaken
  for terrain, while still masking the Greenland ice sheet and Iceland
  highlands at 925/850 hPa - see cps_HCPSclass.xml's comment for the full
  explanation. The MSLP Field is not masked; the index is blanked over
  terrain because HVTL is.

  VERIFY: same checks as cps_HCPSclass.xml (GH abbreviation, fixed-level Field
  spelling, P abbreviation and its Surface level spelling, dx/dy
  pseudo-fields and ConstantField support, levels= value, unit=""
  acceptance), and in addition:
    - the mean sea level pressure Field is spelled
      <Field abbreviation="PMSL" level="MSL"/> below. Neither the PMSL
      abbreviation nor the MSL level spelling could be verified here;
      check both against the site's grid inventory (an existing base
      definition that reads MSLP, or the volume browser's MSL plane) at
      install. If the definition fails to load or comes back empty,
      try level="0.0MSL", then omitting the level attribute, then the
      model's own MSLP abbreviation (some models carry reduced MSLP
      under a model-specific name rather than PMSL). The same change
      applies to cps_HCPSclass.xml.
-->
<DerivedParameter abbreviation="HCPSidx" name="Hart CPS Index -3 to +3" unit="">
    <Method name="cps_HartCPS.executeIndexStd" levels="Surface">
        <!-- Method 1: the baseline MSLP derived parameter (the Volume Browser "MSL Press"), which aliases each model's own field -->
        <Field abbreviation="MSLP" level="MSL"/>
        <Field abbreviation="GH" level="925MB"/>
        <Field abbreviation="GH" level="850MB"/>
        <Field abbreviation="GH" level="700MB"/>
        <Field abbreviation="GH" level="500MB"/>
        <Field abbreviation="GH" level="400MB"/>
        <Field abbreviation="GH" level="300MB"/>
        <Field abbreviation="P" level="Surface"/>
        <Field abbreviation="dx"/>
        <Field abbreviation="dy"/>
        <!-- radiusKm (km): Hart's own 500 km analysis-window half-width,
             used for both HVTL/HVTU and as the mask's ring_radius_km
             (the outer edge of the annulus the depth test averages over) -->
        <ConstantField value="500.0"/>
        <!-- scaleM (m): tanh squashing scale - roughly the |HVTL|/|HVTU|
             magnitude that reads as "fully" warm/cold -->
        <ConstantField value="100.0"/>
        <!-- depthHpa (hPa): the annulus around a candidate point must
             average at least this much higher MSLP than the point itself
             before it counts as a real closed low, not a uniform slope -->
        <ConstantField value="5.0"/>
        <!-- blobKm (km): half-width of the blob painted around each
             detected low's center (a display radius, not the low's own
             true physical size) -->
        <ConstantField value="200.0"/>
        <!-- capHpa: below-ground cap, see cps_HartCPS.py -->
        <ConstantField value="900.0"/>
        <!-- pmslKind: 0 = the first Field is mean sea level pressure (Pa or hPa),
             1 = it is 1000 hPa height, converted at 8 m per hPa -->
        <ConstantField value="0.0"/>
    </Method>
    <Method name="cps_HartCPS.executeIndexStd" levels="Surface">
        <!-- Method 2: the raw PMSL field (verified on GFS at OPC) -->
        <Field abbreviation="PMSL" level="MSL"/>
        <Field abbreviation="GH" level="925MB"/>
        <Field abbreviation="GH" level="850MB"/>
        <Field abbreviation="GH" level="700MB"/>
        <Field abbreviation="GH" level="500MB"/>
        <Field abbreviation="GH" level="400MB"/>
        <Field abbreviation="GH" level="300MB"/>
        <Field abbreviation="P" level="Surface"/>
        <Field abbreviation="dx"/>
        <Field abbreviation="dy"/>
        <!-- radiusKm (km): Hart's own 500 km analysis-window half-width,
             used for both HVTL/HVTU and as the mask's ring_radius_km
             (the outer edge of the annulus the depth test averages over) -->
        <ConstantField value="500.0"/>
        <!-- scaleM (m): tanh squashing scale - roughly the |HVTL|/|HVTU|
             magnitude that reads as "fully" warm/cold -->
        <ConstantField value="100.0"/>
        <!-- depthHpa (hPa): the annulus around a candidate point must
             average at least this much higher MSLP than the point itself
             before it counts as a real closed low, not a uniform slope -->
        <ConstantField value="5.0"/>
        <!-- blobKm (km): half-width of the blob painted around each
             detected low's center (a display radius, not the low's own
             true physical size) -->
        <ConstantField value="200.0"/>
        <!-- capHpa: below-ground cap, see cps_HartCPS.py -->
        <ConstantField value="900.0"/>
        <!-- pmslKind: 0 = the first Field is mean sea level pressure (Pa or hPa),
             1 = it is 1000 hPa height, converted at 8 m per hPa -->
        <ConstantField value="0.0"/>
    </Method>
    <Method name="cps_HartCPS.executeIndexStd" levels="Surface">
        <!-- Method 3: MSLP stored at the Surface level -->
        <Field abbreviation="MSLP" level="Surface"/>
        <Field abbreviation="GH" level="925MB"/>
        <Field abbreviation="GH" level="850MB"/>
        <Field abbreviation="GH" level="700MB"/>
        <Field abbreviation="GH" level="500MB"/>
        <Field abbreviation="GH" level="400MB"/>
        <Field abbreviation="GH" level="300MB"/>
        <Field abbreviation="P" level="Surface"/>
        <Field abbreviation="dx"/>
        <Field abbreviation="dy"/>
        <!-- radiusKm (km): Hart's own 500 km analysis-window half-width,
             used for both HVTL/HVTU and as the mask's ring_radius_km
             (the outer edge of the annulus the depth test averages over) -->
        <ConstantField value="500.0"/>
        <!-- scaleM (m): tanh squashing scale - roughly the |HVTL|/|HVTU|
             magnitude that reads as "fully" warm/cold -->
        <ConstantField value="100.0"/>
        <!-- depthHpa (hPa): the annulus around a candidate point must
             average at least this much higher MSLP than the point itself
             before it counts as a real closed low, not a uniform slope -->
        <ConstantField value="5.0"/>
        <!-- blobKm (km): half-width of the blob painted around each
             detected low's center (a display radius, not the low's own
             true physical size) -->
        <ConstantField value="200.0"/>
        <!-- capHpa: below-ground cap, see cps_HartCPS.py -->
        <ConstantField value="900.0"/>
        <!-- pmslKind: 0 = the first Field is mean sea level pressure (Pa or hPa),
             1 = it is 1000 hPa height, converted at 8 m per hPa -->
        <ConstantField value="0.0"/>
    </Method>
    <Method name="cps_HartCPS.executeIndexStd" levels="Surface">
        <!-- Method 4, fallback for a model with no MSLP in the inventory: 1000 hPa height, converted to an equivalent MSLP at 8 m per hPa (extrapolated inside deep lows and over terrain; the band levels still blank terrain) -->
        <Field abbreviation="GH" level="1000MB"/>
        <Field abbreviation="GH" level="925MB"/>
        <Field abbreviation="GH" level="850MB"/>
        <Field abbreviation="GH" level="700MB"/>
        <Field abbreviation="GH" level="500MB"/>
        <Field abbreviation="GH" level="400MB"/>
        <Field abbreviation="GH" level="300MB"/>
        <Field abbreviation="P" level="Surface"/>
        <Field abbreviation="dx"/>
        <Field abbreviation="dy"/>
        <!-- radiusKm (km): Hart's own 500 km analysis-window half-width,
             used for both HVTL/HVTU and as the mask's ring_radius_km
             (the outer edge of the annulus the depth test averages over) -->
        <ConstantField value="500.0"/>
        <!-- scaleM (m): tanh squashing scale - roughly the |HVTL|/|HVTU|
             magnitude that reads as "fully" warm/cold -->
        <ConstantField value="100.0"/>
        <!-- depthHpa (hPa): the annulus around a candidate point must
             average at least this much higher MSLP than the point itself
             before it counts as a real closed low, not a uniform slope -->
        <ConstantField value="5.0"/>
        <!-- blobKm (km): half-width of the blob painted around each
             detected low's center (a display radius, not the low's own
             true physical size) -->
        <ConstantField value="200.0"/>
        <!-- capHpa: below-ground cap, see cps_HartCPS.py -->
        <ConstantField value="900.0"/>
        <!-- pmslKind: 0 = the first Field is mean sea level pressure (Pa or hPa),
             1 = it is 1000 hPa height, converted at 8 m per hPa -->
        <ConstantField value="1.0"/>
    </Method>
</DerivedParameter>
