<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  EXPERIMENTAL. Style rules for the CPS derived parameters, the Hart
  family HVTL, HVTU, HCPSidx, HCPSclass, HB.

  INSTALL (preferred): copy this file unchanged to the site style rules
  directory under its own name,
    /awips2/edex/data/utility/common_static/site/<SITE>/styleRules/cpsStyleRules.xml
  CAVE loads every XML file in the styleRules directory at every
  localization level and sorts each rule by the style element it holds
  (imageStyle = imagery, contourStyle = contour), so a separate file is
  additive and nothing in the base files has to be edited. Restart CAVE.

  INSTALL (fallback, only if the rules above do not take effect on your
  build): copy the base gridImageryStyleRules.xml to the site level, paste
  the imageStyle rules below into it, do the same for the contourStyle
  rules into a site copy of gridContourStyleRules.xml, and delete this
  file from the site level so the rules are not defined twice.

  Colormaps referenced here ship with this package under
  D2D/colormaps/Grid/ and install to
    /awips2/edex/data/utility/common_static/site/<SITE>/colormaps/Grid/
  The "Grid/" prefix in defaultColormap is the base Grid colormap subdirectory, used so no new folder is needed at site level; the CPS_ file prefix keeps them together in the menu.

  Format follows the base gridImageryStyleRules.xml and
  gridContourStyleRules.xml: one paramLevelMatch per rule with one or more
  parameter children; imagery uses defaultColormap and range; contours use
  contourLabeling with space separated values. VERIFY against a base rule
  on your build if anything fails to apply; the interpolate element on
  imageStyle is the least certain item and can be deleted if the file
  fails to load.
-->
<styleRuleset>

    <!-- Hart family, meters per unit ln p -->
    <styleRule>
        <paramLevelMatch>
            <parameter>HVTL</parameter>
            <parameter>HVTU</parameter>
        </paramLevelMatch>
        <imageStyle>
            <defaultColormap>Grid/CPS_CoreDiverging</defaultColormap>
            <range scale="LINEAR">
                <minValue>-300</minValue>
                <maxValue>300</maxValue>
            </range>
        </imageStyle>
    </styleRule>

    <styleRule>
        <paramLevelMatch>
            <parameter>HVTL</parameter>
            <parameter>HVTU</parameter>
        </paramLevelMatch>
        <contourStyle>
            <contourLabeling labelSpacing="4">
                <values>-300 -200 -100 -50 50 100 200 300</values>
            </contourLabeling>
        </contourStyle>
    </styleRule>

    <styleRule>
        <paramLevelMatch>
            <parameter>HCPSidx</parameter>
        </paramLevelMatch>
        <imageStyle>
            <defaultColormap>Grid/CPS_CoreDiverging</defaultColormap>
            <range scale="LINEAR">
                <minValue>-3</minValue>
                <maxValue>3</maxValue>
            </range>
        </imageStyle>
    </styleRule>

    <!-- Categorical: 0 sym deep warm, 1 sym shallow warm, 2 asymmetric deep
         warm, 3 asymmetric shallow warm, 4 asymmetric cold, 5 sym cold, 6
         mid-level vortex. Range is offset by half a category so each
         code sits in the middle of one color bin; interpolate off so
         colors hold flat across a bin. -->
    <styleRule>
        <paramLevelMatch>
            <parameter>HCPSclass</parameter>
        </paramLevelMatch>
        <imageStyle>
            <interpolate>false</interpolate>
            <defaultColormap>Grid/CPS_HartClass</defaultColormap>
            <range scale="LINEAR">
                <minValue>-0.5</minValue>
                <maxValue>6.5</maxValue>
            </range>
        </imageStyle>
    </styleRule>

    <!-- Parameter B, meters (900-600 hPa equivalent). Its own map,
         CPS_Asymmetry (magenta for positive, teal for negative,
         transparent within 5 m of zero, first opaque step at the 10 m
         onset line with this +/-40 m range), because B is an asymmetry,
         not a temperature, and the red/blue core map read as warm/cold.
         A rare negative B (warm air on the wrong side of the track) is
         visible in teal rather than clipped. -->
    <styleRule>
        <paramLevelMatch>
            <parameter>HB</parameter>
        </paramLevelMatch>
        <imageStyle>
            <defaultColormap>Grid/CPS_Asymmetry</defaultColormap>
            <range scale="LINEAR">
                <minValue>-40</minValue>
                <maxValue>40</maxValue>
            </range>
        </imageStyle>
    </styleRule>

    <!-- The 10 m contour is the Evans and Hart (2003) onset threshold. -->
    <styleRule>
        <paramLevelMatch>
            <parameter>HB</parameter>
        </paramLevelMatch>
        <contourStyle>
            <contourLabeling labelSpacing="4">
                <values>10 20 30 40</values>
            </contourLabeling>
        </contourStyle>
    </styleRule>


</styleRuleset>
