<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  EXPERIMENTAL. Volume Browser fields-menu contribution for the CPS core
  structure derived parameters: the vorticity-proxy family (VTL, VTU,
  CPScat, CPSidx, cpsZ850 - CycloneCore.py) and the height-based, actual
  Hart-method family (HVTL, HVTU, HCPSidx, HB, HCPSclass - cps_HartCPS.py).
  See D2D/README.md.

  VERIFY against cave_static/base/menus/volumebrowser/ on your AWIPS
  version - the contribute element names, attributes (xsi:type values,
  "key" vs. another attribute for the parameter abbreviation), and whether
  this needs to be wired into a parent menu file via an <include> rather
  than dropped into the directory alone. AWIPS versions differ here; treat
  this file as a starting point, not a drop-in.

  HB (added under the Hart heading below) is parameter B (thermal
  asymmetry), a gridded approximation built on the same height and wind
  fields as HVTL/HVTU/HCPSidx - see cps_HartCPS.py's module docstring,
  "Parameter B and the joint class" section. HCPSclass is the joint
  Hart CPS class (all three of B, HVTL, and HVTU bucketed into a single
  7-code field), replacing the retired HCPScat/HETstage fields - see
  cps_HartCPS.hart_class's docstring and D2D/README.md's "Hart CPS family"
  section.
-->
<menuTemplate xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <contribute xsi:type="titleItem" titleText="------ CPS Core (experimental) ------" id="cpsCoreTitle"/>
    <contribute xsi:type="menuItem" menuText="CPS Lower Core (VTL)" key="VTL" indentText="false" id="cpsVTL"/>
    <contribute xsi:type="menuItem" menuText="CPS Upper Core (VTU)" key="VTU" indentText="false" id="cpsVTU"/>
    <contribute xsi:type="menuItem" menuText="CPS Core Class" key="CPScat" indentText="false" id="cpsCPScat"/>
    <contribute xsi:type="menuItem" menuText="CPS Core Index" key="CPSidx" indentText="false" id="cpsCPSidx"/>
    <contribute xsi:type="menuItem" menuText="CPS debug 850 vort" key="cpsZ850" indentText="false" id="cpsZ850"/>

    <contribute xsi:type="titleItem" titleText="------ Hart CPS (height based, experimental) ------" id="hartCpsTitle"/>
    <contribute xsi:type="menuItem" menuText="Hart CPS Lower -VT (HVTL)" key="HVTL" indentText="false" id="hartCpsHVTL"/>
    <contribute xsi:type="menuItem" menuText="Hart CPS Upper -VT (HVTU)" key="HVTU" indentText="false" id="hartCpsHVTU"/>
    <contribute xsi:type="menuItem" menuText="Hart CPS Core Index" key="HCPSidx" indentText="false" id="hartCpsHCPSidx"/>
    <contribute xsi:type="menuItem" menuText="Hart CPS B Asymmetry (HB)" key="HB" indentText="false" id="hartCpsHB"/>
    <contribute xsi:type="menuItem" menuText="Hart CPS Class" key="HCPSclass" indentText="false" id="hartCpsHCPSclass"/>
</menuTemplate>
