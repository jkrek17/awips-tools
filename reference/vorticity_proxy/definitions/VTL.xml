<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  EXPERIMENTAL. Cyclone core structure, lower troposphere:
  relative vorticity at 850 hPa minus relative vorticity at 600 hPa, smoothed
  over ~100 km. Positive = warm core, negative = cold core. Read it only at a
  closed MSLP low; see D2D/README.md.

  Values are scaled by 1e5 for readable sampling: CAVE's sampling readout
  rounds to two decimals, and this field's real magnitude is order 1e-4
  1/s, so an unscaled value always samples as "0.00" - a sampled value of
  12.3 here means 1.23e-4 /s in SI. See CycloneCore.py's UNIT_SCALE.

  VERIFY against an existing definition in
  /awips2/edex/data/utility/common_static/base/derivedParameters/definitions/
  (for example LI.xml or Thickness.xml) that on your AWIPS version:
    - fixed-level Field references use the "850MB" spelling,
    - the "dx"/"dy" pseudo-fields and <ConstantField> are accepted,
    - "Surface" is the right levels= value to make this show under a
      surface plane in the Volume Browser (alternatively use levels="MSL"),
    - unit="" (empty) is accepted for a scaled, no-longer-physical-unit
      field - confirmed to load on a real AWIPS site.
-->
<DerivedParameter abbreviation="VTL" name="CPS Lower Core (vort 850-600) (x1e-5 /s)" unit="">
    <Method name="CycloneCore" levels="Surface">
        <Field abbreviation="uW" level="850MB"/>
        <Field abbreviation="vW" level="850MB"/>
        <Field abbreviation="uW" level="600MB"/>
        <Field abbreviation="vW" level="600MB"/>
        <Field abbreviation="dx"/>
        <Field abbreviation="dy"/>
        <ConstantField value="100.0"/>
    </Method>
</DerivedParameter>
