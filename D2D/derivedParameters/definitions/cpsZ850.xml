<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  EXPERIMENTAL. Debug field: relative vorticity at 850 hPa alone, no
  vertical difference and no smoothing. Exists only to verify grid
  orientation - see "Orientation verification" in D2D/README.md. Compare
  it against D2D's own relative vorticity field at 850 mb on a known
  hurricane: a single positive blob matching D2D's field means the mode
  below is right; a lobed, deformation-like pattern (or an outright sign
  mismatch) means try the next mode.

  Values are scaled by 1e5 for readable sampling: CAVE's sampling readout
  rounds to two decimals, and this field's real magnitude is order 1e-4
  1/s, so an unscaled value always samples as "0.00" - a sampled value of
  12.3 here means 1.23e-4 /s in SI. See CycloneCore.py's UNIT_SCALE. This
  does not change the orientation comparison in this file's own purpose
  (pattern/sign against D2D's own field): both compare the same way
  scaled or not, since D2D's own relative vorticity field is unscaled.

  VERIFY: if your AWIPS version does not support "Module.function" method
  names, copy executeVorticity into its own file CycloneCoreVort.py with
  `execute` as the function name and use Method name="CycloneCoreVort"
  below instead.
-->
<DerivedParameter abbreviation="cpsZ850" name="CPS debug: 850 hPa rel vort (orientation check) (x1e-5 /s)" unit="">
    <Method name="CycloneCore.executeVorticity" levels="Surface">
        <Field abbreviation="uW" level="850MB"/>
        <Field abbreviation="vW" level="850MB"/>
        <Field abbreviation="dx"/>
        <Field abbreviation="dy"/>
        <!-- orientation mode 0..3, see CycloneCore.py; try 1, then 2, then 3
             until cpsZ850 matches D2D relative vorticity at 850 mb -->
        <ConstantField value="1"/>
    </Method>
</DerivedParameter>
