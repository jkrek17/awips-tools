<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  EXPERIMENTAL. Hart CPS combined core index, actual method: same HVTL/
  HVTU and closed-low mask as HCPScat.xml, squashed into a single
  continuous number from -3 (cold core) to +3 (deep warm core) via
  2*tanh(HVTL/scaleM) + tanh(HVTU/scaleM) - see HartCPS.executeIndexStd
  and D2D/README.md's "Hart CPS family" section.

  VERIFY: same checks as HCPScat.xml (GH abbreviation, fixed-level Field
  spelling, dx/dy pseudo-fields and ConstantField support, levels= value,
  unit="" acceptance).
-->
<DerivedParameter abbreviation="HCPSidx" name="Hart CPS Core Index (-3 cold to +3 deep warm)" unit="">
    <Method name="HartCPS.executeIndexStd" levels="Surface">
        <Field abbreviation="GH" level="925MB"/>
        <Field abbreviation="GH" level="850MB"/>
        <Field abbreviation="GH" level="700MB"/>
        <Field abbreviation="GH" level="500MB"/>
        <Field abbreviation="GH" level="400MB"/>
        <Field abbreviation="GH" level="300MB"/>
        <Field abbreviation="dx"/>
        <Field abbreviation="dy"/>
        <!-- radiusKm (km): Hart's own 500 km analysis-window half-width,
             used for both HVTL/HVTU and as the mask's ring_radius_km
             (the outer edge of the annulus the depth test averages over) -->
        <ConstantField value="500.0"/>
        <!-- scaleM (m): tanh squashing scale - roughly the |HVTL|/|HVTU|
             magnitude that reads as "fully" warm/cold -->
        <ConstantField value="100.0"/>
        <!-- depthM (m): the annulus around a candidate point must average
             at least this much higher than the point itself before it
             counts as a real closed low, not a uniform slope -->
        <ConstantField value="40.0"/>
        <!-- blobKm (km): half-width of the blob painted around each
             detected low's center (a display radius, not the low's own
             true physical size) -->
        <ConstantField value="200.0"/>
    </Method>
</DerivedParameter>
