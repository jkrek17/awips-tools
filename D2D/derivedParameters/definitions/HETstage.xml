<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  EXPERIMENTAL. Evans and Hart (2003) extratropical transition stage,
  gridded: at every grid point, 0 (pre-onset) if parameter B (HartCPS.
  parameter_b_grid, see HB.xml) is at or below bThresholdM; 1 (onset) if
  B exceeds bThresholdM while the lower thermal wind HVTL (HartCPS.
  thermal_wind_grid over 925/850/700 hPa) is still zero or positive; 2
  (complete) once HVTL turns strictly negative, regardless of B - see
  HartCPS.et_stage and HartCPS.py's module docstring, "Parameter B and
  ET stage" section, for the full method, including why stage 2 has no
  neutral band (HVTL exactly 0.0 is not stage 2) and why this field has
  no memory of an earlier frame (a storm that re-forms a low-level warm
  core after transitioning, a warm seclusion, drops back to stage 0 or 1
  - read that together with HCPScat's category at the same point and
  time, not as a sign the transition never completed). Blanked (NaN)
  outside of HartCPS.closed_low_mask, computed from 1000 hPa height, the
  same mask HCPScat/HCPSidx use - see HCPScat.xml's comment for the full
  explanation of why 1000 hPa height is used for the mask rather than a
  thermal-wind band level.

  Below-ground masking: every one of the four height Fields above (z1000
  and the three HVTL band levels 925/850/700) is blanked (NaN) before
  its own computation wherever it is below ground for its own pressure,
  using the surface pressure field (P, Surface) and capHpa below - see
  HartCPS.mask_below_ground and HCPScat.xml's comment for the full
  explanation of the capHpa convention.

  Hemisphere: same as HB.xml - the coriolis pseudo-field's sign is the
  hemisphere factor parameter B uses; a 2D field gets the correct sign
  on both sides of a grid straddling the equator.

  VERIFY: same checks as HB.xml and HCPScat.xml (GH abbreviation,
  fixed-level Field spelling, P abbreviation and its Surface level
  spelling, the coriolis pseudo-field's abbreviation, dx/dy
  pseudo-fields and ConstantField support, levels= value, unit=""
  acceptance). If this definition fails to load, replace the coriolis
  Field with <ConstantField value="1.0"/> at the same position to
  assume the Northern Hemisphere.
-->
<DerivedParameter abbreviation="HETstage" name="Hart CPS ET stage (0 pre-onset,1 onset B&gt;10,2 complete VTL&lt;0)" unit="">
    <Method name="HartCPS.executeETStage" levels="Surface">
        <Field abbreviation="GH" level="1000MB"/>
        <Field abbreviation="GH" level="925MB"/>
        <Field abbreviation="GH" level="850MB"/>
        <Field abbreviation="GH" level="700MB"/>
        <Field abbreviation="uW" level="850MB"/>
        <Field abbreviation="vW" level="850MB"/>
        <Field abbreviation="uW" level="700MB"/>
        <Field abbreviation="vW" level="700MB"/>
        <Field abbreviation="uW" level="500MB"/>
        <Field abbreviation="vW" level="500MB"/>
        <Field abbreviation="uW" level="300MB"/>
        <Field abbreviation="vW" level="300MB"/>
        <Field abbreviation="P" level="Surface"/>
        <Field abbreviation="coriolis"/>
        <Field abbreviation="dx"/>
        <Field abbreviation="dy"/>
        <!-- radiusKm (km): Hart's own 500 km analysis-window half-width,
             used for HVTL, parameter B's box-averaged gradient, and the
             mask's own ring_radius_km -->
        <ConstantField value="500.0"/>
        <!-- bThresholdM (m): the Evans and Hart (2003) onset threshold
             for parameter B (900-600 hPa equivalent) -->
        <ConstantField value="10.0"/>
        <!-- layerScale: rescales B from this module's 925-700 hPa layer
             to a 900-600 hPa equivalent - see HB.xml -->
        <ConstantField value="1.4553"/>
        <!-- depthM (m): the closed-low mask's annulus depth test, see
             HCPScat.xml -->
        <ConstantField value="40.0"/>
        <!-- blobKm (km): half-width of the blob painted around each
             detected low's center, see HCPScat.xml -->
        <ConstantField value="200.0"/>
        <!-- capHpa: below-ground cap, see HartCPS.py -->
        <ConstantField value="900.0"/>
    </Method>
</DerivedParameter>
